//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// IREN Signal Pro — Buy/Sell signals + probability-weighted targets + hold time
//
// Designed for NASDAQ:IREN (works on any symbol/timeframe).
//
// What it does:
//   • BUY / SELL signals from an ATR trailing-stop engine (UT-Bot style flip)
//     confirmed by trend (EMA 9/21), momentum (RSI) and volume.
//   • Shaded reward/risk zones per signal, sized by volatility (ATR):
//       green zone  = entry → T1, the high-probability target (1.0 × ATR)
//       light zone  = T1 → T2, the stretch target             (2.2 × ATR)
//       red zone    = entry → trailing stop (risk); it shrinks as the stop
//                     tightens and turns green once the trade is risk-free.
//   • Adaptive end goals: targets are re-evaluated every bar from the live
//     momentum strength (RSI, EMA trend, volume). Strong readings extend the
//     targets; fading readings pull them in. A target locks once hit.
//   • Self-measuring statistics: the script tracks every past signal on the
//     chart and reports the REAL historical hit rate of T1 and T2 and the
//     median holding time, so "how likely" and "how long" are measured on
//     IREN itself — not guessed.
//   • Live dashboard: active signal, age, P&L, targets, expected remaining
//     hold time, sample size.
//   • Alerts for BUY, SELL, T1 hit, T2 hit and exits.
//
// Honest disclaimer: no target is ever reached "for sure". T1 is the target
// with the highest measured probability; the dashboard shows you the exact
// historical hit rate so you can judge it yourself.
// ─────────────────────────────────────────────────────────────────────────────
indicator("IREN Signal Pro — Buy/Sell + Targets + Hold Time",
     shorttitle = "IREN Signal Pro",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500,
     max_boxes_count = 500)

// ── Inputs ───────────────────────────────────────────────────────────────────
grpSig = "Signal engine"
atrLen          = input.int(10,   "ATR length",                        minval = 1,   group = grpSig)
atrMult         = input.float(1.8,"ATR sensitivity (trailing stop)",   minval = 0.1, step = 0.1, group = grpSig,
     tooltip = "Lower = more signals (scalping). Higher = fewer, longer signals (swing). 1.5–2.0 works well on IREN 15m; use 2.5–3.0 on the daily chart.")
minScore        = input.int(2,    "Min confirmations required (0–3)",  minval = 0, maxval = 3, group = grpSig,
     tooltip = "Confirmations: EMA trend, RSI momentum, volume. 3 = only A+ signals, 2 = balanced (default), 0 = every flip.")
allowShorts     = input.bool(true,"Show SELL (short) entries",         group = grpSig)
confirmBarClose = input.bool(true,"Confirm signals on bar close (no repaint)", group = grpSig)

grpFlt = "Confirmations"
emaFastLen = input.int(9,    "Fast EMA",                     group = grpFlt)
emaSlowLen = input.int(21,   "Slow EMA",                     group = grpFlt)
rsiLen     = input.int(14,   "RSI length",                   group = grpFlt)
volLen     = input.int(20,   "Volume average length",        group = grpFlt)
volMult    = input.float(1.0,"Volume must exceed × average", step = 0.1, group = grpFlt)

grpTgt = "Targets"
t1Mult = input.float(1.0, "T1 — high-probability target (× ATR)", step = 0.1, group = grpTgt)
t2Mult = input.float(2.2, "T2 — stretch target (× ATR)",          step = 0.1, group = grpTgt)
adaptTargets = input.bool(true, "Adaptive targets (follow live momentum)", group = grpTgt,
     tooltip = "Targets are re-evaluated every bar from the current momentum strength (RSI, EMA trend, volume). Strong readings extend the targets up to ~1.3–1.5× their base size; fading readings pull them in to ~0.6–0.7×. A target locks the moment it is hit.")
adaptSpeed = input.float(0.25, "Adaptation speed", minval = 0.05, maxval = 1, step = 0.05, group = grpTgt,
     tooltip = "How fast targets move toward their new level each bar. 0.25 = smooth, 1 = instant.")

grpUi = "Display"
showTable     = input.bool(true, "Show stats dashboard", group = grpUi)
tablePosInp   = input.string("top_right", "Dashboard position",
     options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = grpUi)
showEmaRibbon = input.bool(true, "Show EMA 9/21 ribbon", group = grpUi)
showTrail     = input.bool(false, "Show ATR trailing stop line", group = grpUi,
     tooltip = "The stop is already visible as the bottom edge of the red risk zone; enable this to also draw it as a line across the whole chart.")

// ── Colors ───────────────────────────────────────────────────────────────────
colBull  = color.new(#089981, 0)
colBear  = color.new(#f23645, 0)
colT1    = color.new(#26c281, 0)
colT2    = color.new(#00bcd4, 0)
colFlat  = color.new(#787b86, 0)

// zone fills
bgT1     = color.new(#26c281, 82)   // entry → T1
bgT1Hit  = color.new(#26c281, 68)   // after T1 is reached
bgT2     = color.new(#00bcd4, 90)   // T1 → T2
bgT2Hit  = color.new(#00bcd4, 76)
bgRisk   = color.new(#f23645, 84)   // entry → stop
bgSafe   = color.new(#089981, 90)   // stop above entry = risk-free
brT1     = color.new(#26c281, 55)
brT2     = color.new(#00bcd4, 65)
brRisk   = color.new(#f23645, 55)
brSafe   = color.new(#089981, 55)

// ── Core series ──────────────────────────────────────────────────────────────
atrVal  = ta.atr(atrLen)
emaF    = ta.ema(close, emaFastLen)
emaS    = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)
volAvg  = ta.sma(volume, volLen)

// ATR trailing stop (UT-Bot style)
nLoss = atrMult * atrVal
var float trail = na
trail := close > nz(trail[1]) and close[1] > nz(trail[1]) ? math.max(nz(trail[1]), close - nLoss) :
     close < nz(trail[1]) and close[1] < nz(trail[1]) ? math.min(nz(trail[1]), close + nLoss) :
     close > nz(trail[1]) ? close - nLoss : close + nLoss

var int posState = 0
posState := close > trail ? 1 : close < trail ? -1 : nz(posState[1])

baseBuy  = ta.crossover(close, trail)
baseSell = ta.crossunder(close, trail)

// Confirmation score
volOk      = not na(volAvg) and volume > volAvg * volMult
scoreLong  = (emaF > emaS ? 1 : 0) + (rsiVal > 50 ? 1 : 0) + (volOk ? 1 : 0)
scoreShort = (emaF < emaS ? 1 : 0) + (rsiVal < 50 ? 1 : 0) + (volOk ? 1 : 0)
longOk     = scoreLong  >= minScore
shortOk    = scoreShort >= minScore
barOk      = not confirmBarClose or barstate.isconfirmed

// Momentum strength 0..1 — drives the adaptive targets
f_clamp01(float x) =>
    math.max(0.0, math.min(1.0, x))
volRatio  = na(volAvg) or volAvg == 0 ? 1.0 : volume / volAvg
compVol   = f_clamp01((volRatio - 0.8) / 1.2)
strLong   = (f_clamp01((rsiVal - 50) / 25) + f_clamp01((emaF - emaS) / atrVal) + compVol) / 3
strShort  = (f_clamp01((50 - rsiVal) / 25) + f_clamp01((emaS - emaF) / atrVal) + compVol) / 3

// target size factors: weak momentum ≈ 0.7×/0.6× base, max momentum ≈ 1.3×/1.5×
f_t1Factor(float s) => 0.7 + 0.6 * s
f_t2Factor(float s) => 0.6 + 0.9 * s

// ── Helpers ──────────────────────────────────────────────────────────────────
// Historical hit rate of an outcome array (needs ≥5 samples to be meaningful)
f_rate(arr) =>
    float r = na
    if array.size(arr) >= 5
        r := array.avg(arr) * 100
    r

// Format a bar count as human time on the current chart timeframe
f_dur(float nBars) =>
    string out = "—"
    if not na(nBars)
        float mins = nBars * timeframe.in_seconds() / 60.0
        out := mins < 90 ? str.format("~{0,number,#} min", mins) :
             mins < 60 * 36 ? str.format("~{0,number,#.#} h", mins / 60) :
             str.format("~{0,number,#.#} d", mins / 1440)
    out

f_pctTxt(float r) =>
    na(r) ? "" : str.format(" · hit {0,number,#}%", r)

// ── Trade state ──────────────────────────────────────────────────────────────
var int   dir        = 0        // 1 = long, -1 = short, 0 = flat
var float entryPrice = na
var int   entryBar   = na
var float t1         = na
var float t2         = na
var bool  t1Hit      = false
var bool  t2Hit      = false
var int   t1HitBar   = na
var box   boxT1      = na       // entry → T1 zone
var box   boxT2      = na       // T1 → T2 zone
var box   boxRisk    = na       // entry → trailing stop zone

// Historical statistics (long / short kept separate)
var lHold  = array.new_float()  // bars held per closed long signal
var lT1    = array.new_float()  // 1 if T1 was hit, else 0
var lT2    = array.new_float()
var lToT1  = array.new_float()  // bars from entry to T1 hit
var sHold  = array.new_float()
var sT1    = array.new_float()
var sT2    = array.new_float()
var sToT1  = array.new_float()

f_pushCapped(arr, val) =>
    array.push(arr, val)
    if array.size(arr) > 300
        array.shift(arr)

// Draw the three reward/risk zones for a fresh signal
f_zones(float eP, float tp1, float tp2, float stp) =>
    b1 = box.new(bar_index, math.max(eP, tp1), bar_index + 1, math.min(eP, tp1),
         border_color = brT1, border_width = 1, bgcolor = bgT1,
         text = "T1 " + str.tostring(tp1, format.mintick), text_color = colT1,
         text_size = size.small, text_halign = text.align_right, text_valign = text.align_center)
    b2 = box.new(bar_index, math.max(tp1, tp2), bar_index + 1, math.min(tp1, tp2),
         border_color = brT2, border_width = 1, bgcolor = bgT2,
         text = "T2 " + str.tostring(tp2, format.mintick), text_color = colT2,
         text_size = size.small, text_halign = text.align_right, text_valign = text.align_center)
    b3 = box.new(bar_index, math.max(eP, stp), bar_index + 1, math.min(eP, stp),
         border_color = brRisk, border_width = 1, bgcolor = bgRisk,
         text = "stop " + str.tostring(stp, format.mintick), text_color = colBear,
         text_size = size.small, text_halign = text.align_right, text_valign = text.align_center)
    [b1, b2, b3]

// Per-bar event flags (for plots & alerts)
bool longEntry  = false
bool shortEntry = false
bool longExit   = false
bool shortExit  = false
bool t1HitNow   = false
bool t2HitNow   = false

// ── 0. Adapt the open targets to the current readings ───────────────────────
// Strong momentum pushes the end goal further out; fading momentum pulls it
// closer. A target stops moving the moment it is hit.
if adaptTargets and dir != 0 and bar_index > entryBar
    s = dir == 1 ? strLong : strShort
    if not t1Hit
        newT1 = entryPrice + dir * t1Mult * f_t1Factor(s) * atrVal
        t1 := t1 + (newT1 - t1) * adaptSpeed
    if not t2Hit
        newT2 = entryPrice + dir * t2Mult * f_t2Factor(s) * atrVal
        t2 := t2 + (newT2 - t2) * adaptSpeed
        minT2 = t1 + dir * 0.3 * atrVal
        t2 := dir == 1 ? math.max(t2, minT2) : math.min(t2, minT2)

// ── 1. Track target hits on the open signal ─────────────────────────────────
if dir == 1 and bar_index > entryBar
    if not t1Hit and high >= t1
        t1Hit := true
        t1HitBar := bar_index
        t1HitNow := true
    if not t2Hit and high >= t2
        t2Hit := true
        t2HitNow := true
if dir == -1 and bar_index > entryBar
    if not t1Hit and low <= t1
        t1Hit := true
        t1HitBar := bar_index
        t1HitNow := true
    if not t2Hit and low <= t2
        t2Hit := true
        t2HitNow := true
// ── 2. Exits (a trailing-stop flip always closes the open signal) ───────────
if dir == 1 and baseSell and barOk
    f_pushCapped(lHold, bar_index - entryBar)
    f_pushCapped(lT1, t1Hit ? 1.0 : 0.0)
    f_pushCapped(lT2, t2Hit ? 1.0 : 0.0)
    if t1Hit
        f_pushCapped(lToT1, t1HitBar - entryBar)
    longExit := true
    dir := 0
if dir == -1 and baseBuy and barOk
    f_pushCapped(sHold, bar_index - entryBar)
    f_pushCapped(sT1, t1Hit ? 1.0 : 0.0)
    f_pushCapped(sT2, t2Hit ? 1.0 : 0.0)
    if t1Hit
        f_pushCapped(sToT1, t1HitBar - entryBar)
    shortExit := true
    dir := 0
if longExit or shortExit
    box.set_right(boxT1, bar_index)
    box.set_right(boxT2, bar_index)
    box.set_right(boxRisk, bar_index)

// ── 3. Entries ───────────────────────────────────────────────────────────────
longEntry  := dir != 1 and posState == 1 and longOk and barOk
shortEntry := allowShorts and dir != -1 and posState == -1 and shortOk and barOk

if longEntry
    dir := 1
    entryPrice := close
    entryBar := bar_index
    t1 := close + t1Mult * (adaptTargets ? f_t1Factor(strLong) : 1.0) * atrVal
    t2 := close + t2Mult * (adaptTargets ? f_t2Factor(strLong) : 1.0) * atrVal
    t1Hit := false
    t2Hit := false
    t1HitBar := na
    medHold = array.size(lHold) >= 5 ? array.median(lHold) : na
    gradeTxt = scoreLong >= 3 ? "A+" : scoreLong == 2 ? "B" : "C"
    label.new(bar_index, low, "BUY " + gradeTxt + "\n⏱ " + f_dur(medHold),
         style = label.style_label_up, color = colBull, textcolor = color.white, size = size.small,
         tooltip = "Entry " + str.tostring(close, format.mintick) +
             "\nT1 " + str.tostring(t1, format.mintick) + f_pctTxt(f_rate(lT1)) +
             "\nT2 " + str.tostring(t2, format.mintick) + f_pctTxt(f_rate(lT2)) +
             "\nStop " + str.tostring(trail, format.mintick) +
             "\nTypical hold " + f_dur(medHold))
    [b1, b2, b3] = f_zones(entryPrice, t1, t2, trail)
    boxT1 := b1
    boxT2 := b2
    boxRisk := b3

if shortEntry
    dir := -1
    entryPrice := close
    entryBar := bar_index
    t1 := close - t1Mult * (adaptTargets ? f_t1Factor(strShort) : 1.0) * atrVal
    t2 := close - t2Mult * (adaptTargets ? f_t2Factor(strShort) : 1.0) * atrVal
    t1Hit := false
    t2Hit := false
    t1HitBar := na
    medHold = array.size(sHold) >= 5 ? array.median(sHold) : na
    gradeTxt = scoreShort >= 3 ? "A+" : scoreShort == 2 ? "B" : "C"
    label.new(bar_index, high, "SELL " + gradeTxt + "\n⏱ " + f_dur(medHold),
         style = label.style_label_down, color = colBear, textcolor = color.white, size = size.small,
         tooltip = "Entry " + str.tostring(close, format.mintick) +
             "\nT1 " + str.tostring(t1, format.mintick) + f_pctTxt(f_rate(sT1)) +
             "\nT2 " + str.tostring(t2, format.mintick) + f_pctTxt(f_rate(sT2)) +
             "\nStop " + str.tostring(trail, format.mintick) +
             "\nTypical hold " + f_dur(medHold))
    [b1, b2, b3] = f_zones(entryPrice, t1, t2, trail)
    boxT1 := b1
    boxT2 := b2
    boxRisk := b3

// ── 4. Keep the zones attached to the open signal ───────────────────────────
if dir != 0 and not na(boxT1)
    box.set_right(boxT1, bar_index + 1)
    box.set_right(boxT2, bar_index + 1)
    box.set_right(boxRisk, bar_index + 1)
    // target zones follow the adaptive targets and lock/darken once hit
    box.set_top(boxT1, math.max(entryPrice, t1))
    box.set_bottom(boxT1, math.min(entryPrice, t1))
    box.set_text(boxT1, (t1Hit ? "T1 ✓ " : "T1 ") + str.tostring(t1, format.mintick))
    box.set_bgcolor(boxT1, t1Hit ? bgT1Hit : bgT1)
    box.set_top(boxT2, math.max(t1, t2))
    box.set_bottom(boxT2, math.min(t1, t2))
    box.set_text(boxT2, (t2Hit ? "T2 ✓ " : "T2 ") + str.tostring(t2, format.mintick))
    box.set_bgcolor(boxT2, t2Hit ? bgT2Hit : bgT2)
    // the risk zone follows the trailing stop and flips green once risk-free
    box.set_top(boxRisk, math.max(entryPrice, trail))
    box.set_bottom(boxRisk, math.min(entryPrice, trail))
    riskFree = dir == 1 ? trail >= entryPrice : trail <= entryPrice
    box.set_bgcolor(boxRisk, riskFree ? bgSafe : bgRisk)
    box.set_border_color(boxRisk, riskFree ? brSafe : brRisk)
    box.set_text_color(boxRisk, riskFree ? colBull : colBear)
    box.set_text(boxRisk, (riskFree ? "stop ✓ " : "stop ") + str.tostring(trail, format.mintick))

// ── 5. Plots ─────────────────────────────────────────────────────────────────
plot(showTrail and bar_index > atrLen ? trail : na, "ATR trailing stop",
     color = posState == 1 ? colBull : colBear, linewidth = 2)
pF = plot(showEmaRibbon ? emaF : na, "EMA fast", color = color.new(colBull, 60))
pS = plot(showEmaRibbon ? emaS : na, "EMA slow", color = color.new(colBear, 60))
fill(pF, pS, color = emaF > emaS ? color.new(colBull, 88) : color.new(colBear, 88), title = "EMA ribbon")
plotshape(longExit and not shortEntry, "Exit long", shape.xcross, location.abovebar, colFlat, size = size.tiny)
plotshape(shortExit and not longEntry, "Exit short", shape.xcross, location.belowbar, colFlat, size = size.tiny)

// ── 6. Dashboard ─────────────────────────────────────────────────────────────
tPos = tablePosInp == "top_right" ? position.top_right :
     tablePosInp == "top_left" ? position.top_left :
     tablePosInp == "bottom_right" ? position.bottom_right : position.bottom_left
var table tbl = table.new(tPos, 2, 12, border_width = 1, border_color = color.new(color.gray, 70),
     frame_width = 1, frame_color = color.new(color.gray, 50), bgcolor = color.new(color.black, 25))

f_cell(int row, string k, string v, color vCol) =>
    table.cell(tbl, 0, row, k, text_color = color.new(color.white, 30), text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, row, v, text_color = vCol, text_size = size.small, text_halign = text.align_right)

if barstate.islast and showTable
    isLong  = dir == 1
    holdArr = isLong ? lHold : sHold
    t1Arr   = isLong ? lT1 : sT1
    t2Arr   = isLong ? lT2 : sT2
    toT1Arr = isLong ? lToT1 : sToT1
    medHold = array.size(holdArr) >= 5 ? array.median(holdArr) : na
    medToT1 = array.size(toT1Arr) >= 5 ? array.median(toT1Arr) : na
    age     = dir != 0 ? bar_index - entryBar : na
    remain  = not na(medHold) and not na(age) ? math.max(medHold - age, 0) : na
    pnl     = dir != 0 ? (close / entryPrice - 1) * 100 * dir : na
    nSig    = array.size(lHold) + array.size(sHold)

    table.cell(tbl, 0, 0, "IREN SIGNAL PRO", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 0, timeframe.period + (timeframe.isintraday ? "m" : ""), text_color = color.new(color.white, 40), text_size = size.small, text_halign = text.align_right)

    f_cell(1, "Signal", dir == 1 ? "LONG ▲" : dir == -1 ? "SHORT ▼" : "FLAT — wait", dir == 1 ? colBull : dir == -1 ? colBear : colFlat)
    f_cell(2, "Entry", dir != 0 ? str.tostring(entryPrice, format.mintick) : "—", color.white)
    f_cell(3, "Open P&L", not na(pnl) ? str.format("{0,number,#.##}%", pnl) : "—", not na(pnl) and pnl >= 0 ? colBull : colBear)
    f_cell(4, "T1 (high-prob)", dir != 0 ? str.tostring(t1, format.mintick) + (t1Hit ? "  ✓" : "") + (na(f_rate(t1Arr)) ? "" : str.format("  ({0,number,#}%)", f_rate(t1Arr))) : "—", colT1)
    f_cell(5, "T2 (stretch)", dir != 0 ? str.tostring(t2, format.mintick) + (t2Hit ? "  ✓" : "") + (na(f_rate(t2Arr)) ? "" : str.format("  ({0,number,#}%)", f_rate(t2Arr))) : "—", colT2)
    f_cell(6, "Trailing stop", str.tostring(trail, format.mintick), posState == 1 ? colBull : colBear)
    f_cell(7, "Typical hold", f_dur(medHold), color.white)
    f_cell(8, "Time to T1", f_dur(medToT1), color.white)
    f_cell(9, "Est. remaining", dir != 0 ? f_dur(remain) : "—", color.white)
    sAct = dir == -1 or (dir == 0 and posState == -1) ? strShort : strLong
    momTxt = str.format("{0,number,#}%", sAct * 100) + (not adaptTargets ? "" : sAct > 0.65 ? " ▲ extending" : sAct < 0.35 ? " ▼ pulling in" : " → steady")
    f_cell(10, "Momentum", momTxt, sAct > 0.65 ? colBull : sAct < 0.35 ? colBear : color.white)
    f_cell(11, "Sample", str.tostring(nSig) + " signals", color.new(color.white, 40))

// ── 7. Alerts ────────────────────────────────────────────────────────────────
alertcondition(longEntry,  "BUY signal",  "IREN Signal Pro: BUY — targets & hold time on chart")
alertcondition(shortEntry, "SELL signal", "IREN Signal Pro: SELL — targets & hold time on chart")
alertcondition(t1HitNow,   "T1 reached",  "IREN Signal Pro: high-probability target T1 reached — consider taking partial profit")
alertcondition(t2HitNow,   "T2 reached",  "IREN Signal Pro: stretch target T2 reached — consider closing")
alertcondition(longExit or shortExit, "Signal exit", "IREN Signal Pro: trailing stop flipped — signal closed")
