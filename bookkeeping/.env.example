# --- Database -------------------------------------------------------------
# Local development database (matches docker-compose.yml).
DATABASE_URL="postgresql://bookkeeping:bookkeeping@localhost:5432/bookkeeping"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-secret"
# Canonical URL of the app (used for auth callbacks and absolute links).
AUTH_URL="http://localhost:3000"
# Set to "true" to allow creating the first user via the registration page.
# After the owner account exists, registration is closed automatically.
ALLOW_REGISTRATION="true"

# --- Application encryption ----------------------------------------------
# 32-byte key, base64. Encrypts the omzetbelastingnummer and TOTP secrets
# at the application layer. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="change-me-generate-a-random-key"

# --- Document storage -----------------------------------------------------
# "local" (development) or "s3" (production, any S3-compatible service).
STORAGE_DRIVER="local"
# Local driver: directory for original documents (kept out of git).
STORAGE_LOCAL_PATH="./var/storage"

# S3 driver (only read when STORAGE_DRIVER="s3"). Never make the bucket public.
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Force path-style addressing for MinIO and most S3-compatibles.
S3_FORCE_PATH_STYLE="true"

# --- Uploads --------------------------------------------------------------
# Maximum upload size in bytes (default 25 MiB).
MAX_UPLOAD_BYTES="26214400"

# --- Optional providers (all disabled by default; privacy-first) ----------
# OCR is optional. The app is fully functional without it.
# "none" | "stub" (deterministic local demo extractor, no network)
OCR_PROVIDER="none"
# Malware scanning provider: "none" | "clamav" (requires clamd socket)
MALWARE_SCANNER="none"
CLAMD_SOCKET=""
